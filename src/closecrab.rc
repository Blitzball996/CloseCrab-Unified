// Microsoft Visual C++ resource script
#include <windows.h>

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_ICON1               ICON    "..\\icons\\closecrab.ico"

// Version Information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,4,5,0
 PRODUCTVERSION 0,4,5,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Blitzball Labs"
            VALUE "FileDescription", "CloseCrab - Claude Code CLI"
            VALUE "FileVersion", "0.4.5.0"
            VALUE "InternalName", "closecrab"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "closecrab.exe"
            VALUE "ProductName", "CloseCrab-Unified"
            VALUE "ProductVersion", "0.4.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
