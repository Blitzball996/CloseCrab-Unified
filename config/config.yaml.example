# CloseCrab-Unified Configuration

server:
  port: 9001
  host: "127.0.0.1"

database:
  path: "data/closecrab.db"

logging:
  level: "info"

# ============================================
# Provider: local, anthropic, openai, local-moe
# Defaults to anthropic so a fresh install works out of the box.
#
# local-moe: runs 125B+ models locally on your GPU — no cloud, no API costs.
#   The engine uses your GPU VRAM for hot experts, system RAM for all experts,
#   and SSD for the n-gram lookup table. A 12 GB GPU can run a 125B model.
#   Set moe.model_path below, or run /local to download and select a model.
# ============================================
provider: "anthropic"

# ============================================
# Local MoE Engine (provider: local-moe)
#
# How it works (125B on 12 GB GPU):
#   GPU VRAM  : dense weights + KV cache + expert cache (~4000 hot experts)
#   System RAM: all 24576 experts pinned for CPU fallback
#   NVMe/SSD  : n-gram lookup table (~28 GB), read via OS page cache
#   Router lookahead queues PCIe DMA for the next experts before they're needed
#
# Quick start:
#   1. /local detect              -- check your hardware
#   2. /local list                -- see which models fit
#   3. /local download qwen-iq3_xxs  -- download (47 GB, resumable)
#   4. Edit this file:
#        provider: "local-moe"
#        moe:
#          model_path: "models/moe/qwen-iq3_xxs"
#          model_id:   "qwen-iq3_xxs"
#   5. Restart CloseCrab
#
# Available models (Qwen3.8-Flash-Next family):
#   qwen-q2_0       34 GB  smallest/fastest, 6 GB VRAM min
#   qwen-iq2_xs     39 GB  fast + good quality, 6 GB VRAM min
#   qwen-iq3_xxs    47 GB  recommended for 12 GB GPUs
#   qwen-iq3_s      55 GB  higher quality, 16 GB VRAM or 64 GB RAM
#   qwen-ud-q4_k_xl 62 GB  best quality, 24 GB VRAM needed
#   qwen-coder      30 GB  code-tuned, weaker on general text
# ============================================
moe:
  # Full path to downloaded model pack directory.
  # Leave empty to auto-detect hardware and pick recommended model.
  model_path: ""
  # Model id ("qwen-iq3_xxs" etc.). Auto-selected from hardware when empty.
  model_id:   ""
  # Where /local download saves model files.
  models_dir: "models/moe"
  # Context window length (tokens). 32768 is safe for most GPUs.
  context_len: 32768

# ============================================
# API Configuration (for anthropic/openai mode)
# ============================================
api:
  base_url: "https://yikoulian.cc/"
  api_key: ""
  model: "claude-opus-4-7"
  fallback_model: "claude-sonnet-4-20250514"
  cache_ttl_minutes: 5
  # Reasoning effort: low | medium | high | xhigh | max ("ultra" = xhigh).
  # Per-run override: --effort <level> or CLOSECRAB_EFFORT; /effort saves here.
  effort: "xhigh"

# ============================================
# Profiles — switch url + api_key + model in one command
#
#   In-app:  /profile <name>
#   CLI:     closecrab --profile <name>
#
# Inactive profiles are ignored at startup.
# The active profile overrides api.base_url, api.api_key, api.model.
# ============================================
profiles:
  yikoulian:
    url: "https://yikoulian.cc/"
    api_key: ""
    model: "claude-opus-4-7"
  official:
    url: "https://api.anthropic.com/"
    api_key: ""
    model: "claude-opus-4-8"

# ============================================
# HTTP Proxy (optional)
# Also reads from env: CLOSECRAB_PROXY, https_proxy, HTTPS_PROXY
# Set CLOSECRAB_NO_PROXY=1 to force a direct connection ignoring proxy env vars.
# Example: "http://127.0.0.1:7897"
# ============================================
proxy: ""

# ============================================
# Local LLM Configuration
# ============================================
llm:
  model_path: "models/deepseek-moe-16b-chat.Q4_K_M.gguf"
  max_tokens: 4096
  temperature: 0.7

# ============================================
# RAG Configuration
# ============================================
rag:
  embedding_model_path: "models/bge-small-zh/onnx/model_quantized.onnx"
  embedding_tokenizer_path: "models/bge-small-zh/tokenizer.json"
  reranker_model_path: "models/bge-reranker-base/onnx/model_uint8.onnx"
  reranker_tokenizer_path: "models/bge-reranker-base/tokenizer.json"
